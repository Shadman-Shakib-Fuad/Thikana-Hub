# Copy to deployment/production.env on the production host only. Never commit it.
# Generate a fresh 32-byte encryption key for a fresh production database. Restores require the original key.
CLIENT_URL=https://thikanahub.example.com
MONGODB_URI=mongodb+srv://REPLACE_MAIN
MONGODB_DB_NAME=thikanahub_production
AUDIT_MONGODB_URI=mongodb+srv://REPLACE_AUDIT
AUDIT_DB_NAME=thikanahub_audit_production
ADDRESS_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
